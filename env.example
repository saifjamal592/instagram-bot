# ============================================================
#  YOUR BOT SETTINGS — Fill these in on Render.com
#  (Do NOT share these with anyone)
# ============================================================

# Make up any secret word — you'll paste this into Meta dashboard too
# Example: mysecretword123
VERIFY_TOKEN=

# Your Instagram access token from the Meta App dashboard
# You'll get this after connecting your Instagram account
ACCESS_TOKEN=

# The word people must comment to receive the DM
# Example: LINK   or   INFO   or   PRICE
KEYWORD=

# The message that gets sent to them automatically
# Example: Hey! Here's the link you asked for: https://yourlink.com
DM_MESSAGE=
